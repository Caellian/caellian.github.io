{
  "name": "blog-builder",
  "version": "0.0.0",
  "main": "./run/index.js",
  "type": "module",
  "scripts": {
    "preinstall": "npm install --prefix ./highlight",
    "build:highlight": "npm run build --prefix ./highlight",
    "build": "npm run build:highlight",
    "start": "npm run build && tsx ./index.js",
    "watch": "npm run build && tsx ./index.js -- watch --dev",
    "lint": "eslint . src/",
    "lint:types": "tsc --checkJs --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --roots src --testMatch '**/*.test.[jt]s'"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@jest/globals": "29.4.3",
    "@types/esprima": "^4.0.6",
    "@types/estree": "^1.0.6",
    "@types/hast": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.1",
    "@types/split2": "^4.2.3",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "hast": "^0.0.2",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "dependencies": {
    "args-parser": "^1.3.0",
    "bcp47": "^1.1.2",
    "esprima-next": "^6.0.3",
    "hast-util-insert": "^1.0.0",
    "hast-util-to-html": "^9.0.3",
    "hast-util-to-text": "^4.0.2",
    "highlight": "file:highlight",
    "jsonschema": "^1.4.1",
    "on-exit-leak-free": "^2.1.2",
    "pino": "^9.5.0",
    "pino-abstract-transport": "^2.0.0",
    "pino-caller": "^3.4.0",
    "pino-pretty": "^13.0.0",
    "rehype": "^13.0.2",
    "rehype-mathjax": "^6.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sonic-boom": "^4.2.0",
    "source-map-support": "^0.5.21",
    "split2": "^4.2.0",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile-matter": "^5.0.0",
    "yaml": "^2.0.0"
  }
