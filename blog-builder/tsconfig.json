{
    "compilerOptions": {
      "strict": false,
      "module": "NodeNext",
      "moduleResolution": "nodenext",
      "types": ["node", "jest"],
      "lib": ["ESNext"],

      "checkJs": true,
      "allowJs": true,
      "esModuleInterop": true,
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "sourceMap": true,

      "typeRoots": ["./node_modules/@types", "./types", "../types"],
      "rootDir": "./"
    },
    "include": ["main.js", "src/**/*.js", "types/**/*.d.ts", "src/unist/hast-utils.ts"]
  }
  