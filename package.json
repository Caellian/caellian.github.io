{
  "name": "caellian-portfolio",
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "preview": "vite preview --host",
    "install:blog": "npm install --prefix ./blog-builder",
    "preinstall": "npm run install:blog",
    "build:blog": "npm start --prefix ./blog-builder",
    "build:post-schema": "json2ts ./blog-builder/post.schema.json ./types/post.d.ts",
    "build:pre": "npm run build:blog && npm run build:post-schema",
    "build": "vite build",
    "check": "svelte-check",
    "check:watch": "svelte-check --watch",
    "lint": "prettier --check --plugin-search-dir=. . && eslint .",
    "format": "prettier --write --plugin-search-dir=. ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "eslint-plugin-svelte": "^3.13.0",
    "html-minifier": "^4.0.0",
    "json-schema-to-typescript": "^15.0.3",
    "svelte-eslint-parser": "^1.4.0",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "@js-joda/core": "^5.6",
    "@sveltejs/kit": "~2.8",
    "cheerio": "^1.0.0",
    "eslint": "^9.15",
    "eslint-config-prettier": "^9.1",
    "prettier": "^3.3",
    "prettier-plugin-svelte": "^3.3",
    "stylus": "^0.64",
    "svelte": "~5.2",
    "svelte-check": "~4.1",
    "svelte-preprocess": "~6.0",
    "to-px": "^1.1",
    "vite": "^5.4"
  },
  "engines": {
    "node": ">=22.0",
    "npm": ">=10.0"
  }
}
